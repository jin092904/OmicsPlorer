# Copy to a secret-managed location or pass with --env-file. Never commit real values.
COMPOSE_PROJECT_NAME=omicsplorer
OMICSPLORER_IMAGE_TAG=local

POSTGRES_DB=genofinder
POSTGRES_USER=genofinder
POSTGRES_PASSWORD=replace-with-a-long-random-value
APP_DB_USER=genofinder_app
APP_DB_PASSWORD=replace-with-another-long-random-value

API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

OLLAMA_MODEL_EMBED=qwen3-embedding:8b
OLLAMA_MODEL_EXTRACTION=gemma4:31b
OLLAMA_MODEL_AIPICK=gemma4:31b
AI_PICK_ENABLED=0
RERANKER_TOP_N=20
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional ingest/API policy identifiers.
NCBI_API_KEY=
NCBI_EUTILS_API_KEY=

# Optional Firebase configuration. Client identifiers are public configuration;
# service-account credentials must never be committed or included in an image.
FIREBASE_ADMIN_CREDENTIALS_HOST_PATH=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Explicit maintenance cap. A write run requires the separate sol4-commit profile.
SOL4_AUTO_DAILY_CAP=100
