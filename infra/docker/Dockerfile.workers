# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# ADR 0002 T9: non-root + 최소 base. (v0: python:3.12-slim, 사유는 Dockerfile.api 헤더 참조)

# ---- builder ----
ARG PYTHON_IMAGE=python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
FROM ${PYTHON_IMAGE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy

RUN pip install --no-cache-dir uv==0.11.14

WORKDIR /build

COPY apps/workers/pyproject.toml apps/workers/uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

COPY apps/workers/src ./src
COPY apps/workers/scripts ./scripts
COPY apps/workers/data ./data
COPY apps/workers/README.md ./README.md

RUN uv sync --frozen --no-dev

# ---- runtime ----
FROM ${PYTHON_IMAGE} AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app:/app/scripts" \
    PATH="/app/.venv/bin:${PATH}"

RUN apt-get -o APT::Sandbox::User=root update \
    && apt-get -o APT::Sandbox::User=root install --no-install-recommends -y ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --no-create-home --shell /usr/sbin/nologin --uid 1001 app \
    && mkdir -p /app/logs \
    && chmod 0777 /app/logs

WORKDIR /app

COPY --from=builder /build/.venv /app/.venv
COPY --from=builder /build/src /app/src
COPY --from=builder /build/scripts /app/scripts
COPY --from=builder /build/data /app/data

USER app

# `celery` 바이너리는 builder 단계의 absolute path 가 shebang 에 baked-in 됨 (uv 특성).
# python -m celery 로 우회 — module entrypoint 는 path 영향 받지 않음.
ENTRYPOINT ["python", "-m", "celery"]
CMD ["-A", "src.celery_app", "worker", "--loglevel=INFO"]
